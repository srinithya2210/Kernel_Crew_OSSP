#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h> //for wait systemcall
#include<time.h> //for clock() c_p_s systemcall
int main()
{
int fd[2]; //parameters for anonymous pipe
int data; //vaiarable that writes anonymous pipe
int start,end; //variable that take start and end times
double timetaken, efficiency; //variables that calculates the communication time
pipe(fd); //creating a anonymous pipe
start = clock(); //storing the strta time
if(fork()==0) //creating a child as consumer
{
close(fd[1]); //closing that write of the pipe
printf("Consumer \n"); //starting the vonsumer
for(int i=0;i<5;i++) //getting the consumer data from the pipe
{
read(fd[0],&data,sizeof(data)); //consuwer is reading the data from child
printf("Consumer %d \n",data);
}
close(fd[0]); //closing the read pipe in the child
}
else
{
close(fd[0]); //closing the read pipe in the parent
printf("Producer \n"); //initializing  the parent the producer
for(int i=1;i<=5;i++) //defing the producer data
{
data = i*10; //initializing the data values in the parent
write(fd[1],&data,sizeof(data)); //writing dtaa into the pipe
printf("Produced %d\n",data); //printing the produces data
}
close(fd[1]); //closing the write end of the pipe
wait(NULL); //parent waits foe the child to complete
end = clock(); //closing the clock to take the communication time
timetaken = (double)(end-start)/CLOCKS_PER_SEC; //calculating the overall time
printf("Communication time is %lf\n",timetaken); //printlng the timetaken
efficiency = 5 / timetaken;
printf("efficiency is %lf\n", efficiency);

}
}
